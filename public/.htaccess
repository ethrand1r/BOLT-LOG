# Apache config for GoDaddy cPanel hosting (upload the contents of dist/ to public_html).
# The build uses build.format 'file': /teklif-al is served from teklif-al.html, and
# pages like hakkimizda.html sit next to a hakkimizda/ folder, so directory slashes are off.

Options -Indexes -MultiViews
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical origin: https://bolt-log.com (certificate checks under .well-known stay reachable).
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://bolt-log.com%{REQUEST_URI} [L,R=301,NE]

  # No trailing slashes (canonical URLs have none).
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^ %1 [L,R=301,NE]

  # /index.html and /page.html redirect to their clean URLs.
  RewriteRule ^index\.html$ / [L,R=301]
  RewriteCond %{THE_REQUEST} \s/([^?\s]+)\.html[\s?]
  RewriteRule ^ /%1 [L,R=301,NE]

  # Serve clean URLs from the matching .html file.
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Hashed build assets never change; pages revalidate so updates show up at once.
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
