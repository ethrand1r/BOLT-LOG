---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumb, { type Crumb } from './Breadcrumb.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  lead?: string;
  crumbs: Crumb[];
  /** With an image the head becomes a dark photographic band (counts as the page's one dark band). */
  image?: ImageMetadata;
  imageAlt?: string;
}

const { lang, title, lead, crumbs, image, imageAlt = '' } = Astro.props;
---

<section class:list={['page-head', { 'page-head--image on-dark': image }]}>
  {
    image && (
      <>
        <Picture
          src={image}
          alt={imageAlt}
          formats={['avif', 'webp']}
          widths={[768, 1280, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="page-head-media"
        />
        <div class="page-head-scrim" aria-hidden="true" />
      </>
    )
  }
  <div class="container page-head-inner">
    <Breadcrumb lang={lang} items={crumbs} onDark={!!image} />
    <h1>{title}</h1>
    {lead && <p class="page-lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-head {
    position: relative;
    padding-block: var(--space-12) var(--space-16);
    background: var(--surface-alt);
    overflow: hidden;
    isolation: isolate;
  }

  .page-head-inner {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  h1 {
    max-width: 18ch;
    font-size: var(--text-display);
    font-weight: var(--weight-black);
  }

  .page-lead {
    max-width: 52ch;
    color: var(--text-muted);
    font-size: var(--text-lg);
  }

  .page-head--image {
    display: grid;
    align-items: end;
    min-height: var(--page-head-image-height);
    padding-block: var(--space-12);
    background: var(--surface-dark);
  }

  .page-head--image .page-lead {
    color: var(--text-on-dark-muted);
  }

  .page-head :global(.page-head-media) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-head-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, var(--scrim-strong) 0%, var(--scrim-medium) 60%, var(--scrim-clear) 100%),
      linear-gradient(0deg, var(--scrim-strong) 0%, var(--scrim-clear) 55%);
  }

  @media (max-width: 47.99rem) {
    .page-head-scrim {
      background: linear-gradient(0deg, var(--scrim-strong) 15%, var(--scrim-medium) 100%);
    }
  }
</style>
