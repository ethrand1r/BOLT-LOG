---
import { Icon } from 'astro-icon/components';
import Button from '../ui/Button.astro';
import { company } from '../../data/site';
import { path } from '../../i18n/routes';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  text: string;
  /** Defaults to the quote page; service pages pass ?mode=... */
  quoteHref?: string;
}

const { lang, title, text, quoteHref } = Astro.props;
const t = useTranslations(lang);
---

<section class="cta-band" aria-labelledby="cta-band-title">
  <div class="container cta-grid">
    <div class="cta-copy">
      <h2 id="cta-band-title">{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-actions">
      <div class="cta-buttons">
        <Button href={quoteHref ?? path('quote', lang)} variant="dark" icon="ph:arrow-right">{t('cta.quote')}</Button>
        <Button href={company.whatsapp} variant="secondary" icon="ph:whatsapp-logo" target="_blank" rel="noopener">
          {t('cta.whatsapp')}
        </Button>
      </div>
      <a class="cta-phone tabular" href={company.phones[0].href}>
        <Icon name="ph:phone" aria-hidden="true" />
        {company.phones[0].display}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: var(--space-16);
    background: var(--accent);
    color: var(--on-accent);
  }

  .cta-grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .cta-copy {
    display: grid;
    gap: var(--space-3);
  }

  .cta-copy h2 {
    font-size: var(--text-3xl);
    font-weight: var(--weight-black);
  }

  .cta-copy p {
    max-width: 40ch;
    font-size: var(--text-lg);
  }

  .cta-actions {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .cta-phone {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-target);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    text-decoration: none;
  }

  .cta-phone :global(svg) {
    width: var(--icon-md);
    height: var(--icon-md);
  }

  @media (hover: hover) and (pointer: fine) {
    .cta-phone:hover {
      text-decoration: underline;
    }
  }

  @media (min-width: 64rem) {
    .cta-grid {
      grid-template-columns: 1.2fr 1fr;
    }

    .cta-actions {
      justify-items: end;
    }
  }
</style>
