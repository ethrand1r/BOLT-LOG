---
import { Icon } from 'astro-icon/components';
import { path } from '../../i18n/routes';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  /** Sentence ending after the notice link, e.g. "...to respond to my message." */
  after: string;
}

const { lang, after } = Astro.props;
const t = useTranslations(lang);
---

<div class="consent">
  <input id="f-consent" type="checkbox" name="consent" required aria-describedby="f-consent-error" data-label="KVKK" />
  <label for="f-consent">
    {t('quote.consentBefore')}<a href={path('kvkk', lang)} target="_blank" rel="noopener">{t('quote.consentLink')}</a>{after}
    <span class="field-req" aria-hidden="true">*</span>
  </label>
  <p class="field-error" id="f-consent-error" hidden>
    <Icon name="ph:warning-circle" aria-hidden="true" />
    <span></span>
  </p>
</div>
