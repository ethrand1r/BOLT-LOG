---
import { Icon } from 'astro-icon/components';
import { serviceLinks } from '../../data/navigation';
import { path } from '../../i18n/routes';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Values match the transport-mode keys the quote page will read from the query string.
const modes = serviceLinks.map((s) => ({ value: s.label.split('.')[1], label: t(s.label) }));
---

<div class="container quick-quote-wrap">
  <form class="quick-quote" action={path('quote', lang)} method="get" aria-labelledby="qq-title">
    <div class="qq-intro">
      <h2 id="qq-title" class="qq-title">{t('home.quickQuote.title')}</h2>
      <p class="qq-text">{t('home.quickQuote.text')}</p>
    </div>

    <div class="field">
      <label for="qq-mode">{t('home.quickQuote.mode')}</label>
      <div class="select">
        <select id="qq-mode" name="mode">
          <option value="">{t('home.quickQuote.modePlaceholder')}</option>
          {modes.map((m) => <option value={m.value}>{m.label}</option>)}
        </select>
        <Icon name="ph:caret-down" aria-hidden="true" />
      </div>
    </div>

    <div class="field">
      <label for="qq-origin">{t('home.quickQuote.origin')}</label>
      <input id="qq-origin" name="origin" type="text" autocomplete="off" placeholder={t('home.quickQuote.originPlaceholder')} />
    </div>

    <div class="field">
      <label for="qq-destination">{t('home.quickQuote.destination')}</label>
      <input
        id="qq-destination"
        name="destination"
        type="text"
        autocomplete="off"
        placeholder={t('home.quickQuote.destinationPlaceholder')}
      />
    </div>

    <button class="qq-submit" type="submit">
      {t('cta.quote')}
      <Icon name="ph:arrow-right" aria-hidden="true" />
    </button>
  </form>
</div>

<style>
  .quick-quote-wrap {
    position: relative;
    z-index: var(--z-base);
    margin-top: calc(-1 * var(--quote-overlap));
  }

  .quick-quote {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--surface);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  .qq-title {
    font-size: var(--text-xl);
  }

  .qq-text {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .field {
    display: grid;
    gap: var(--space-2);
    align-content: end;
  }

  label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  input,
  select {
    width: 100%;
    height: var(--field-height);
    padding-inline: var(--space-4);
    background: var(--surface);
    border: var(--border-width) solid var(--line-strong);
    border-radius: var(--radius-sm);
    font-size: var(--text-base);
    transition: border-color var(--duration-hover) ease;
  }

  input::placeholder {
    color: var(--text-muted);
    opacity: 1;
  }

  .select {
    position: relative;
  }

  select {
    appearance: none;
    padding-inline-end: var(--space-10);
    cursor: pointer;
  }

  .select :global(svg) {
    position: absolute;
    right: var(--space-4);
    top: 50%;
    width: var(--icon-sm);
    height: var(--icon-sm);
    transform: translateY(-50%);
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    input:hover,
    select:hover {
      border-color: var(--text);
    }
  }

  .qq-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: var(--field-height);
    padding-inline: var(--space-6);
    background: var(--accent);
    color: var(--on-accent);
    border-radius: var(--radius-sm);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
    align-self: end;
    transition:
      background-color var(--duration-hover) ease,
      transform var(--duration-press) var(--ease-out);
  }

  .qq-submit:active {
    transform: scale(var(--press-scale));
  }

  .qq-submit :global(svg) {
    width: var(--icon-sm);
    height: var(--icon-sm);
  }

  @media (hover: hover) and (pointer: fine) {
    .qq-submit:hover {
      background: var(--accent-hover);
    }
  }

  @media (min-width: 48rem) {
    .quick-quote {
      grid-template-columns: 1fr 1fr;
    }

    .qq-intro {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .quick-quote {
      grid-template-columns: 1.3fr 1fr 1fr 1fr auto;
      align-items: end;
      gap: var(--space-5);
      padding: var(--space-8);
    }

    .qq-intro {
      grid-column: auto;
      align-self: center;
    }
  }
</style>
