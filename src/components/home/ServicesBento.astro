---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { ImageMetadata } from 'astro';
import air from '../../assets/images/service-air.jpg';
import road from '../../assets/images/service-road.jpg';
import sea from '../../assets/images/service-sea.jpg';
import rail from '../../assets/images/service-rail.jpg';
import intermodal from '../../assets/images/service-intermodal.jpg';
import warehousing from '../../assets/images/service-warehousing.jpg';
import { serviceLinks } from '../../data/navigation';
import { path } from '../../i18n/routes';
import { useTranslations, type Lang, type UiKey } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const images: Record<string, ImageMetadata> = { air, road, sea, rail, intermodal, warehousing };
const cards = serviceLinks.map((s) => {
  const key = s.label.split('.')[1];
  return { ...s, key, image: images[key], text: `home.services.${key}` as UiKey };
});
---

<section class="section services" aria-labelledby="services-title">
  <div class="container">
    <div class="services-head">
      <h2 id="services-title">{t('home.services.title')}</h2>
      <a class="arrow-link" href={path('services', lang)}>
        {t('nav.allServices')}
        <Icon name="ph:arrow-right" aria-hidden="true" />
      </a>
    </div>

    <ul role="list" class="bento">
      {
        cards.map((c, i) => (
          <li class={`cell cell--${c.key}`} data-reveal style={`--i: ${i}`}>
            <a class="card" href={path(c.route, lang)}>
              <Image
                src={c.image}
                alt=""
                widths={[480, 800, 1200]}
                sizes="(min-width: 64rem) 40vw, (min-width: 48rem) 50vw, 100vw"
                class="card-media"
              />
              <span class="card-body">
                <span class="card-icon" aria-hidden="true">
                  {c.icon && <Icon name={c.icon} />}
                </span>
                <span class="card-title">{t(c.label)}</span>
                <span class="card-text">{t(c.text)}</span>
              </span>
              <span class="card-arrow" aria-hidden="true">
                <Icon name="ph:arrow-up-right" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .services-head h2 {
    max-width: 18ch;
  }

  .bento {
    display: grid;
    gap: var(--space-4);
  }

  .card {
    position: relative;
    display: flex;
    align-items: end;
    height: 100%;
    min-height: var(--card-min-height);
    padding: var(--space-6);
    overflow: hidden;
    color: var(--text-on-dark);
    text-decoration: none;
    border-radius: var(--radius-md);
    background: var(--surface-dark);
    isolation: isolate;
  }

  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, var(--scrim-strong) 0%, var(--scrim-medium) 45%, var(--scrim-clear) 80%);
  }

  .card :global(.card-media) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-media) var(--ease-out);
  }

  .card-body {
    display: grid;
    gap: var(--space-2);
    max-width: 30ch;
  }

  .card-icon {
    display: grid;
    place-items: center;
    width: var(--icon-chip);
    height: var(--icon-chip);
    margin-bottom: var(--space-2);
    background: var(--accent);
    color: var(--on-accent);
    border-radius: var(--radius-sm);
  }

  .card-icon :global(svg) {
    width: var(--icon-md);
    height: var(--icon-md);
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
  }

  .card-text {
    color: var(--text-on-dark-muted);
    font-size: var(--text-base);
  }

  .card-arrow {
    position: absolute;
    top: var(--space-5);
    right: var(--space-5);
    display: grid;
    place-items: center;
    width: var(--tap-target);
    height: var(--tap-target);
    border: var(--border-width) solid var(--line-on-dark);
    border-radius: var(--radius-full);
    transition:
      background-color var(--duration-hover) ease,
      color var(--duration-hover) ease,
      transform var(--duration-hover) var(--ease-out);
  }

  .card-arrow :global(svg) {
    width: var(--icon-md);
    height: var(--icon-md);
  }

  .card:active {
    transform: scale(var(--press-scale));
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover :global(.card-media) {
      transform: scale(1.04);
    }

    .card:hover .card-arrow {
      background: var(--accent);
      color: var(--on-accent);
      border-color: var(--accent);
      transform: rotate(45deg);
    }
  }

  @media (min-width: 48rem) {
    .bento {
      grid-template-columns: 1fr 1fr;
    }

    .cell--air,
    .cell--warehousing {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .bento {
      grid-template-columns: 1.25fr 1fr 1fr;
      grid-auto-rows: var(--bento-row);
    }

    .cell--air {
      grid-column: 1;
      grid-row: 1 / span 2;
    }

    .cell--air .card-title {
      font-size: var(--text-2xl);
    }

    .cell--warehousing {
      grid-column: 1 / -1;
    }
  }
</style>
