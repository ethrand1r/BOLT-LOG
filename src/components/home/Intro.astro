---
import { Icon } from 'astro-icon/components';
import { path } from '../../i18n/routes';
import { useTranslations, type Lang, type UiKey } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const paragraphs = ['p1', 'p2', 'p3'].map((k) => t(`home.intro.${k}` as UiKey));
---

<section class="section intro" aria-labelledby="intro-title">
  <div class="container intro-grid">
    <div class="intro-lead">
      <h2 id="intro-title" class="statement">{t('home.intro.statement')}</h2>
      <a class="arrow-link" href={path('aboutUs', lang)}>
        {t('home.intro.link')}
        <Icon name="ph:arrow-right" aria-hidden="true" />
      </a>
    </div>

    <div class="article">
      {
        paragraphs.map((text, i) => (
          <p data-reveal style={`--i: ${i}`}>
            {text}
          </p>
        ))
      }
    </div>
  </div>
</section>

<style>
  .intro-grid {
    display: grid;
    gap: var(--space-10);
  }

  .intro-lead {
    display: grid;
    gap: var(--space-6);
    align-content: start;
    justify-items: start;
  }

  .statement {
    max-width: 30ch;
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .article {
    display: grid;
    gap: var(--space-5);
    max-width: var(--measure);
    padding-top: var(--space-6);
    border-top: var(--border-width-strong) solid var(--text);
    font-size: var(--text-md);
  }

  /* The opening paragraph sets the scene; the rest reads as supporting body text. */
  .article p:first-child {
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
  }

  .article p:not(:first-child) {
    color: var(--text-muted);
  }

  @media (min-width: 64rem) {
    .intro-grid {
      grid-template-columns: 5fr 6fr;
      gap: var(--space-16);
    }

    .intro-lead {
      position: sticky;
      top: calc(var(--header-height) + var(--space-8));
    }
  }
</style>
