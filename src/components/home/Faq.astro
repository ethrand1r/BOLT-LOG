---
import FaqSection, { type FaqItem } from '../sections/FaqSection.astro';
import { path } from '../../i18n/routes';
import { useTranslations, type Lang, type UiKey } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const items: FaqItem[] = [1, 2, 3, 4].map((n) => ({
  q: t(`home.faq.q${n}` as UiKey),
  a: t(`home.faq.a${n}` as UiKey),
  link: n === 3 ? { href: path('incoterms', lang), label: t('home.faq.a3Link') } : undefined,
}));
---

<FaqSection lang={lang} id="home-faq" title={t('home.faq.title')} text={t('home.faq.text')} items={items} />
