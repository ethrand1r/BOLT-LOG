---
import Button from '../ui/Button.astro';
import { path } from '../../i18n/routes';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- Temporary: replaced by the real home page sections in step 2. -->
<section class="section">
  <div class="container placeholder">
    <h1>{t('home.placeholderTitle')}</h1>
    <p>{t('home.placeholderText')}</p>
    <div class="actions">
      <Button href={path('quote', lang)} icon="ph:arrow-right">{t('cta.quote')}</Button>
      <Button href={path('services', lang)} variant="secondary">{t('nav.services')}</Button>
    </div>
  </div>
</section>

<style>
  .placeholder {
    display: grid;
    gap: var(--space-6);
    min-height: 50dvh;
    align-content: center;
  }

  h1 {
    max-width: 16ch;
    font-size: var(--text-display);
  }

  p {
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
