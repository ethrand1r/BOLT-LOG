---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPages from '../components/legal/LegalPages.astro';
import { useTranslations } from '../i18n/ui';

const lang = 'tr';
const t = useTranslations(lang);
---

<BaseLayout lang={lang} routeKey="cookies" title={t('cookiesPage.metaTitle')} description={t('cookiesPage.metaDescription')}>
  <LegalPages lang={lang} page="cookies" />
</BaseLayout>
