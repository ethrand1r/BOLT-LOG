---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePlaceholder from '../../components/home/HomePlaceholder.astro';
import { useTranslations } from '../../i18n/ui';

const lang = 'en';
const t = useTranslations(lang);
---

<BaseLayout lang={lang} routeKey="home" title={t('home.metaTitle')} description={t('home.metaDescription')}>
  <HomePlaceholder lang={lang} />
</BaseLayout>
